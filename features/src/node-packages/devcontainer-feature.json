{
  "id": "node-packages",
  "version": "1.0.1",
  "name": "Node Packages",
  "documentationURL": "https://github.com/shokkunrf/devcontainer/blob/develop/features/src/node-packages/README.md",
  "description": "Installs specified npm packages globally",
  "options": {
    "packages": {
      "type": "string",
      "default": "",
      "description": "Comma-separated list of npm packages to install (e.g., '@devcontainers/cli,prettier')"
    }
  },
  "installsAfter": ["ghcr.io/devcontainers/features/node"]
}
