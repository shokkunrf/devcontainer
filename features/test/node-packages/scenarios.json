{
  "official-debian": {
    "image": "debian:trixie",
    "features": {
      "ghcr.io/devcontainers/features/node:2": {
        // Drop this pin once Node.js LTS no longer needs libatomic1 (nodejs/node#63270)
        "version": "24"
      },
      "node-packages": {
        "packages": "@devcontainers/cli,prettier,@google/gemini-cli"
      }
    }
  },
  "official-node-debian": {
    "image": "node:24",
    "features": {
      "node-packages": {
        "packages": "@devcontainers/cli,prettier,@google/gemini-cli"
      }
    },
    "remoteUser": "node"
  },
  "official-node-alpine": {
    "image": "node:24-alpine",
    "features": {
      "node-packages": {
        "packages": "@devcontainers/cli,prettier,@google/gemini-cli"
      }
    },
    "remoteUser": "node"
  },
  "devcontainer-base-debian": {
    "image": "mcr.microsoft.com/devcontainers/base:debian",
    "features": {
      "ghcr.io/devcontainers/features/node:2": {},
      "node-packages": {
        "packages": "@devcontainers/cli,prettier,@google/gemini-cli"
      }
    },
    "remoteUser": "vscode"
  },
  "devcontainer-base-ubuntu-root": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "ghcr.io/devcontainers/features/node:2": {},
      "node-packages": {
        "packages": "@devcontainers/cli,prettier,@google/gemini-cli"
      }
    }
  },
  "devcontainer-base-ubuntu-remote-user": {
    "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
    "features": {
      "ghcr.io/devcontainers/features/node:2": {},
      "node-packages": {
        "packages": "@devcontainers/cli,prettier,@google/gemini-cli"
      }
    },
    "remoteUser": "vscode"
  },
  "devcontainer-node": {
    "image": "mcr.microsoft.com/devcontainers/javascript-node:24",
    "features": {
      "node-packages": {
        "packages": "@devcontainers/cli,prettier,@google/gemini-cli"
      }
    },
    "remoteUser": "node"
  },
  "shokkunrf-base": {
    "image": "ghcr.io/shokkunrf/devcontainer-images/base:latest",
    "features": {
      "node-packages": {
        "packages": "@devcontainers/cli,prettier,@google/gemini-cli"
      }
    },
    "remoteUser": "developer"
  }
