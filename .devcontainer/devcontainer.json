{
  "image": "ghcr.io/shokkunrf/devcontainer-images/base:3",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "moby": false
    },
    "ghcr.io/shokkunrf/devcontainer-features/node-packages:1": {
      "packages": "@devcontainers/cli"
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/developer/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/developer/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gemini,target=/home/developer/.gemini,type=bind,consistency=cached"
  ],
  "initializeCommand": "${localWorkspaceFolder}/.devcontainer/initializeCommand.sh",
  "remoteUser": "developer"
}
