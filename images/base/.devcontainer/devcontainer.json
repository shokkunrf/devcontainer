{
  "build": {
    "context": ".",
    "dockerfile": "./Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2.7.1": {
      "installZsh": "false",
      "username": "developer",
      "upgradePackages": "true"
    },
    "ghcr.io/devcontainers/features/git:1.3.8": {
      "version": "latest",
      "ppa": "false"
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/node:2.1.1": {
      "version": "26"
    },
    "ghcr.io/shokkunrf/devcontainer-features/node-packages:1.0.1": {
      "packages": "prettier"
    },
    "ghcr.io/shokkunrf/devcontainer-features/wd:1.0.0": {}
  },
  "customizations": {
    "vscode": {
      "extensions": ["esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  "remoteUser": "developer"
}
